{
  "name": "letra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Letra — a 3D letter-learning adventure for pre-K kids. Built for the ElevenLabs x Zed Hack #6.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "audio:generate": "node --import tsx scripts/generate-audio.ts",
    "audio:generate-all": "node --import tsx scripts/generate-audio.ts --generate-all",
    "audio:archive": "node --import tsx scripts/generate-audio.ts --archive",
    "audio:list": "node --import tsx scripts/generate-audio.ts --list"
  },
  "dependencies": {
    "nipplejs": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
