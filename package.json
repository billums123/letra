{
  "name": "letra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Letra \u2014 a 3D letter-learning adventure for pre-K kids. Built for the ElevenLabs x Zed Hack #6.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test:planet": "node --import tsx scripts/planet-test.ts",
    "audio:generate": "node --import tsx scripts/generate-audio.ts",
    "audio:generate-all": "node --import tsx scripts/generate-audio.ts --generate-all",
    "audio:archive": "node --import tsx scripts/generate-audio.ts --archive",
    "audio:list": "node --import tsx scripts/generate-audio.ts --list",
    "music:generate": "node --import tsx scripts/generate-music.ts",
    "music:generate-force": "node --import tsx scripts/generate-music.ts --force",
    "music:list": "node --import tsx scripts/generate-music.ts --list",
    "icons:generate": "node --import tsx scripts/generate-icons.ts",
    "icons:generate-force": "node --import tsx scripts/generate-icons.ts --force",
    "icons:list": "node --import tsx scripts/generate-icons.ts --list",
    "logo:generate": "node --import tsx scripts/generate-logo.ts",
    "logo:generate-force": "node --import tsx scripts/generate-logo.ts --force",
    "logo:list": "node --import tsx scripts/generate-logo.ts --list",
    "sfx:generate": "node --import tsx scripts/generate-sfx.ts",
    "sfx:generate-force": "node --import tsx scripts/generate-sfx.ts --force",
    "sfx:list": "node --import tsx scripts/generate-sfx.ts --list",
    "trophies:generate": "node --import tsx scripts/generate-trophies.ts",
    "trophies:generate-force": "node --import tsx scripts/generate-trophies.ts --force",
    "trophies:list": "node --import tsx scripts/generate-trophies.ts --list",
    "images:optimize": "node --import tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "nipplejs": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^17.4.2",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.2.0"
  }
}
