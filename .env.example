# Required to generate the static audio bundle. Get one at https://elevenlabs.io.
# Without it, the game falls back to the browser's built-in Web Speech API.
ELEVENLABS_API_KEY=

# Optional: override the default voice (a cheerful warm voice works best for kids).
# Default is "Rachel" if unset.
ELEVENLABS_VOICE_ID=

# Optional: model id. eleven_multilingual_v2 is balanced; eleven_turbo_v2_5 is faster.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
